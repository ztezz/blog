VITE_API_URL=https://api.example.com/api

# Backend
PORT=5001
FRONTEND_URL=https://blog.thuonghongthai97.workers.dev,https://www.example.com
PUBLIC_API_URL=https://api.example.com
# Set to the number of trusted reverse proxies (usually 1 for Nginx/Caddy).
TRUST_PROXY=1

# Relative paths are resolved from the backend process working directory.
SQLITE_PATH=server/data/cosmogis.db
BCRYPT_ROUNDS=12
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
# Used only when the database has no users yet.
ADMIN_PASSWORD=change-this-password

# Initial values used only when the database settings row is created.
# Afterwards, manage daily AI publishing from Admin > Settings > Tự động AI.
AI_AUTOMATION_ENABLED=false
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=
AI_MODEL=your-9router-model-or-combo
AI_RUN_HOUR_UTC=1
AI_AUTHOR=CosmoGIS AI
AI_DEFAULT_IMAGE_URL=https://picsum.photos/seed/cosmogis-ai/800/400
# Comma-separated allowlists. Only configure sources you are permitted to process.
AI_RSS_FEEDS=https://example.com/feed.xml
AI_WEBSITE_URLS=https://example.com/news
