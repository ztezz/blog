VITE_API_URL=https://api.example.com/api

# Backend
PORT=5001
FRONTEND_URL=https://blog.thuonghongthai97.workers.dev,https://www.example.com
PUBLIC_API_URL=https://api.example.com
# Set to the number of trusted reverse proxies (usually 1 for Nginx/Caddy).
TRUST_PROXY=1

# Relative paths are resolved from the backend process working directory.
SQLITE_PATH=server/data/cosmogis.db
BCRYPT_ROUNDS=12
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
# Used only when the database has no users yet.
ADMIN_PASSWORD=change-this-password
